    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/typeorm": "^11.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "bullmq": "^6.3.1",
    "cache-manager": "^7.2.9",
    "cache-manager-redis-yet": "^5.1.5",
